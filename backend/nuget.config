<?xml version="1.0" encoding="utf-8"?>
<!-- Config de NuGet solo para este repo: usa nuget.org para todos los paquetes,
     sin depender del packageSourceMapping global de cada maquina. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
