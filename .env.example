# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el archivo .env al repositorio.

# ===== Base de datos (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ===== Backend (.NET) =====
API_URL=http://localhost:5000

# ===== Frontend (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:5000

# ===== n8n =====
N8N_URL=http://localhost:5678
N8N_API_KEY=

# ===== IA (se definen en la Fase 5) =====
VISION_AI_API_KEY=
IMAGE_AI_API_KEY=

# ===== Prolog (verificador) =====
# Ruta al ejecutable swipl (ej. C:\Program Files\swipl\bin\swipl.exe)
SWIPL_PATH=

# ===== Blender =====
# Ruta al ejecutable blender.exe
BLENDER_PATH=

# ===== Almacenamiento =====
STORAGE_PATH=./storage
