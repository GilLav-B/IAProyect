# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el archivo .env al repositorio.

# ===== Base de datos (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ===== Backend (.NET) =====
API_URL=http://localhost:5000

# ===== Frontend (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:5000

# ===== n8n =====
N8N_URL=http://localhost:5678
N8N_API_KEY=

# ===== IA (Fase 5) =====
# Key de OpenAI: la usa SOLO el servicio de IA en Python (ai-service lee este .env)
OPENAI_API_KEY=
# Modelo para analizar imagenes y proponer disenos, y modelo de imagenes
OPENAI_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Calidad de las imagenes: low | medium | high (high = mas realista, ~1 min y mas caro)
OPENAI_IMAGE_QUALITY=high
# Clave compartida para que n8n le reporte resultados a la API (cualquier texto largo y aleatorio)
N8N_CALLBACK_SECRET=
# Servicio de IA en Python (ai-service): prompts, OpenAI, imagenes, Blender y exportaciones
AI_SERVICE_URL=http://127.0.0.1:8100

# ===== Prolog (verificador) =====
# Ruta al ejecutable swipl (ej. C:\Program Files\swipl\bin\swipl.exe)
SWIPL_PATH=

# ===== Blender =====
# Ruta a blender.exe (opcional: si esta vacia se busca en C:\Program Files\Blender Foundation)
BLENDER_PATH=

# ===== Almacenamiento =====
STORAGE_PATH=./storage
